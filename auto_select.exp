#!/usr/bin/expect -f

# Set initial counter
set counter 1

# Get oneshot.py path from environment or use default
if { [info exists env(SNX_ONESHOT)] } {
    set oneshot_path $env(SNX_ONESHOT)
} else {
    set oneshot_path "/sdcard/nh_files/modules/oneshot.py"
}

# Infinite loop
while {1} {
    spawn python3 -u $oneshot_path -w -i $env(adapter) -K -l

set timeout 10
expect {
    -re "Select target.*refresh.*" {
        send "$counter\r"
        incr counter
    }
    timeout {
        puts "Prompt not found — retrying"
    }
    eof {
        wait
    }
}
}
